# Copiar a .env (desarrollo) o cargar como variables en Vercel (producción). Todas son opcionales.

# A dónde van las llamadas a la API. En desarrollo se deja vacío: la web usa /api y Vite lo reenvía a VITE_API_PROXY.
# En producción, si la API vive en otro dominio: https://api.ejemplo.org (y en la API: COOKIE_SAMESITE=none, CORS).
VITE_API_URL=

# Solo desarrollo: dónde corre la API local (uvicorn api.main:app).
VITE_API_PROXY=http://127.0.0.1:8000

# La app de Streamlit en producción: los links «Chat» y «Mis publicaciones» abren ahí hasta las fases 2 y 3.
VITE_STREAMLIT_URL=https://chatbotvvaa.streamlit.app
